{
  "openapi": "3.1.0",
  "info": {
    "title": "Norsolis förfrågningar",
    "version": "2026-10-19",
    "description": "Skicka en offertförfrågan om batteri och solceller (villa eller bostadsrättsförening) eller en anmälan till nyhetsbrevet till Norsolis. Tjänsten är gratis för användaren. VIKTIGT för agenter: skicka bara efter att användaren uttryckligen har godkänt inskicket och uppgifterna, och hitta aldrig på uppgifter. Fråga aldrig efter personnummer. Instruktioner: https://norsolis.com/agenter.html",
    "contact": {
      "name": "Norsolis",
      "email": "jan.svensson@norsolis.com",
      "url": "https://norsolis.com/"
    }
  },
  "servers": [
    {
      "url": "https://script.google.com/macros/s/AKfycby5GUxDZQ5uTXZV521vJRx_0FWMC4_RNoT4jABRK5e6lnb0pQqXrCHFyR2Wl-wSSUVi/exec",
      "description": "Mottagare (Google Apps Script). Svarar via en omdirigering; följ den."
    }
  ],
  "paths": {
    "/": {
      "post": {
        "operationId": "skickaForfragan",
        "summary": "Skicka en förfrågan (villa, brf eller nyhetsbrev)",
        "description": "Kräver uttryckligt samtycke från användaren innan anropet görs. Skicka alla obligatoriska fält: den nuvarande mottagaren kan svara \"ok\" även när obligatoriska fält saknas (förfrågan sparas då inte).",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "oneOf": [
                  {
                    "title": "Villa – fritext",
                    "description": "Offertförfrågan för villa, läge=fritext: postnummer, kontakt och samtycke krävs; behov är frivilligt (\"ej angivet\" om tomt). Skicka hustyp, projekt och elanvandning som \"ej angivet\" och behov även i meddelande.",
                    "type": "object",
                    "required": [
                      "typ",
                      "lage",
                      "postnummer",
                      "namn",
                      "epost",
                      "kontaktsatt",
                      "samtycke",
                      "t0"
                    ],
                    "properties": {
                      "typ": {
                        "type": "string",
                        "description": "Formulärtyp.",
                        "enum": [
                          "villa"
                        ]
                      },
                      "behov": {
                        "type": "string",
                        "description": "Användarens behov med egna ord. Frivilligt i läge \"fritext\" (skicka \"ej angivet\" om användaren inte vill skriva något) och skickas inte alls i läge \"fragor\". I läge fritext: skicka samma text även i meddelandefältet som \"Behov: <text>\" så att den sparas även i äldre versioner av mottagaren.",
                        "maxLength": 3000
                      },
                      "postnummer": {
                        "type": "string",
                        "description": "Svenskt postnummer, 5 siffror.",
                        "pattern": "^[0-9]{3} ?[0-9]{2}$"
                      },
                      "hustyp": {
                        "type": "string",
                        "description": "Hustyp. I läge fritext: skicka \"ej angivet\" (krävs av nuvarande mottagare).",
                        "enum": [
                          "Villa",
                          "Radhus",
                          "Parhus",
                          "Fritidshus",
                          "Annat",
                          "Vet inte",
                          "ej angivet"
                        ]
                      },
                      "projekt": {
                        "type": "string",
                        "description": "Projekt. I läge fritext: skicka \"ej angivet\" (krävs av nuvarande mottagare).",
                        "enum": [
                          "Batteri + solceller",
                          "Batteri till befintliga solceller",
                          "ej angivet"
                        ]
                      },
                      "elanvandning": {
                        "type": "string",
                        "description": "Elanvandning. I läge fritext: skicka \"ej angivet\" (krävs av nuvarande mottagare).",
