                        "enum": [
                          "Inom 3 månader",
                          "Inom 3–12 månader",
                          "Senare",
                          "Vet inte"
                        ]
                      },
                      "tak": {
                        "type": "string",
                        "description": "Tak.",
                        "enum": [
                          "Tegel eller betongpannor",
                          "Plåt",
                          "Papp",
                          "Annat",
                          "Vet inte"
                        ]
                      },
                      "kwh": {
                        "type": "string",
                        "description": "Årsförbrukning i kWh om känd (valfritt).",
