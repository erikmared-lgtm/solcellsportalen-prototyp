                          "Under 10 000 kWh",
                          "10 000–15 000 kWh",
                          "15 000–20 000 kWh",
                          "20 000–25 000 kWh",
                          "Över 25 000 kWh",
                          "Vet inte",
                          "ej angivet"
                        ]
                      },
                      "kontaktsatt": {
                        "type": "string",
                        "description": "Kontaktsatt.",
                        "enum": [
                          "E-post",
