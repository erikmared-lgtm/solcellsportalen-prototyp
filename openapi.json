                        ]
                      },
                      "tid": {
                        "type": "string",
                        "description": "Tid.",
                        "enum": [
                          "Förmiddag",
                          "Eftermiddag",
                          "Kväll"
                        ]
                      },
                      "elbil": {
                        "type": "string",
                        "description": "Elbil.",
                        "enum": [
                          "Ja",
                          "Nej",
                          "Planerar"
